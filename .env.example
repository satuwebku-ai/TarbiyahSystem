# =============================================================================
#  .env PRODUKSI - hasil perbaikan dari .env lokal
#  Cari "GANTI" dan isi semuanya sebelum dipakai. Simpan sebagai .env (akhiran baris LF).
#  Jangan commit/bagikan file ini. Setelah mengubah: php artisan config:clear (atau config:cache).
# =============================================================================
# CATATAN: setelah migrasi, menu "Pengaturan Aplikasi" (panel pengelola, khusus yang punya izin settings.*)
# bisa MENIMPA kunci berikut dari database: APP_NAME, ATTENDANCE_TIMEZONE, MAIL_* (MAILER, HOST, PORT, SCHEME, USERNAME, PASSWORD, FROM_*),
# NOTIFY_MAIL, PELAJAR_REGISTRATION, FINGERPRINT_MAX_*. Nilai di sini tetap jadi bawaan sampai diubah lewat menu.
# Kunci lain (APP_KEY, DB_*, APP_DEBUG, domain, SESSION_*, TRUSTED_PROXIES, ADMIN_*) hanya lewat file ini.

APP_NAME="Tarbiyah System"                    # GANTI bila nama aplikasinya lain
APP_ENV=production
APP_KEY=base64:Vr9r7bqMWVKsN9PaK8J47AdnAy1ju954aWg7qsY9He0=
APP_DEBUG=false
APP_URL=https://apps-ku.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# --- Domain & subdomain (mode subdomain) -------------------------------------
# Butuh DNS/vhost untuk: <APP_DOMAIN>, pengelola.<APP_DOMAIN>, pegawai.<APP_DOMAIN>, pelajar.<APP_DOMAIN>
# (paling mudah: wildcard DNS *.apps-ku.my.id + sertifikat SSL wildcard).
AUTH_ROUTING_MODE=subdomain
APP_DOMAIN=apps-ku.my.id
ADMIN_SUBDOMAIN=pengelola
PEGAWAI_SUBDOMAIN=pegawai
PELAJAR_SUBDOMAIN=pelajar
# Pendaftaran mandiri pelajar di pelajar.<domain>/register (bawaan: true = terbuka untuk umum).
PELAJAR_REGISTRATION=true

# --- Zona waktu absensi --------------------------------------------------------
# Asia/Jakarta (WIB), Asia/Makassar (WITA), atau Asia/Jayapura (WIT). Samakan dengan lokasi sekolah.
ATTENDANCE_TIMEZONE=Asia/Makassar

BCRYPT_ROUNDS=12

# --- Log ------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------------
# Jangan pakai root. Buat user khusus: CREATE USER 'pelajar_app'@'localhost' IDENTIFIED BY '...';
# GRANT ALL ON pelajar01.* TO 'pelajar_app'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pelajar01
DB_USERNAME=GANTI_user_database
DB_PASSWORD=GANTI_password_database_yang_kuat

# --- Sesi, antrean, cache ---------------------------------------------------------
# SESSION_DOMAIN dibiarkan null: tiap subdomain (pengelola/pegawai/pelajar) punya sesi sendiri.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true                    # wajib true bila situs memakai https
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Notifikasi/email dikirim lewat antrean: WAJIB ada proses "php artisan queue:work" yang selalu hidup
# (supervisor/systemd). Tanpa itu notifikasi tidak pernah terkirim.
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Email ------------------------------------------------------------------------
# Sebelumnya MAIL_MAILER=log (email hanya ditulis ke file log, tidak terkirim). Isi SMTP asli,
# atau matikan email dengan NOTIFY_MAIL=false (notifikasi lonceng di aplikasi tetap jalan).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=GANTI-smtp.domainanda.id
MAIL_PORT=587
MAIL_USERNAME=GANTI_user_smtp
MAIL_PASSWORD=GANTI_password_smtp
MAIL_FROM_ADDRESS="no-reply@apps-ku.my.id"
MAIL_FROM_NAME="${APP_NAME}"
NOTIFY_MAIL=true

# --- Super Admin awal (dipakai AdminSeeder, hanya saat akun belum ada) ----------------
# Isi sekali sebelum "php artisan db:seed", lalu HAPUS ADMIN_PASSWORD dari file ini.
# Kosong di produksi = kata sandi acak dibuat seeder. Wajib memenuhi kebijakan kata sandi admin.
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=GANTI@domainanda.id
# ADMIN_PASSWORD=

# --- Mesin fingerprint (/iclock) -------------------------------------------------------
# Bila di belakang reverse proxy/CDN: IP proxy dipisah koma, atau * (lihat docs/FINGERPRINT.md).
TRUSTED_PROXIES=
# FINGERPRINT_MAX_FUTURE_MINUTES=10
# FINGERPRINT_MAX_PUNCH_AGE_DAYS=60
# FINGERPRINT_MAX_PUNCHES_PER_REQUEST=1000

# --- CAPTCHA (login, lupa kata sandi, pendaftaran pelajar) -------------------------------
# Bisa juga diatur dari menu Pengaturan Aplikasi > CAPTCHA (nilai di sana menimpa .env).
# CAPTCHA_PROVIDER=off          # off | math | turnstile | recaptcha | hcaptcha
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# CAPTCHA_LOGIN=true
# CAPTCHA_FORGOT=true
# CAPTCHA_REGISTER=true

VITE_APP_NAME="${APP_NAME}"
